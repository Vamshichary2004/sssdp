def   add(a , b):
        return  a + b
#End  of  the  function
print(add(10 , 20))  #  30
print(add('Hyder' , 'abad'))
print(add(10.8 , 20.6))
print(add(True , False))
print(add(3 + 4j , 5 + 6j))
print(add(25 , 10.8))
print(add([25 , 10.8 , 'Hyd'] , [True , None , 3+4j , 'Sec']))
#print(add(10 , '20'))